@model IReadOnlyList<AdminBusinessRowViewModel>
@{
    ViewData["Title"] = "İşletme yönetimi";
    var status = ViewBag.Status as string;
}

<nav class="bb-breadcrumb" aria-label="Sayfa yolu">
    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Yönetim paneli</a>
    <span>İşletmeler</span>
</nav>

<div class="panel-card p-3 mb-4">
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-sm @(string.IsNullOrWhiteSpace(status) ? "bb-btn-primary" : "bb-btn-outline")" asp-action="Index">Tümü</a>
        <a class="btn btn-sm @(status == "pending" ? "bb-btn-primary" : "bb-btn-outline")" asp-action="Index" asp-route-status="pending">Bekleyen</a>
        <a class="btn btn-sm @(status == "approved" ? "bb-btn-primary" : "bb-btn-outline")" asp-action="Index" asp-route-status="approved">Onaylı</a>
        <a class="btn btn-sm @(status == "passive" ? "bb-btn-primary" : "bb-btn-outline")" asp-action="Index" asp-route-status="passive">Pasif</a>
        <a class="btn btn-sm @(status == "featured" ? "bb-btn-primary" : "bb-btn-outline")" asp-action="Index" asp-route-status="featured">Öne çıkan</a>
    </div>
</div>

<div class="panel-card p-4">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>İşletme adı</th><th>Kategori</th><th>İlçe</th><th>Durum</th><th>Öne çıkan</th><th>Oluşturulma tarihi</th><th>İşlemler</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Name</strong></td>
                        <td>@item.CategoryName</td>
                        <td>@item.DistrictName</td>
                        <td>
                            <span class="status-pill @(item.IsApproved ? (item.IsActive ? "status-success" : "status-muted") : "status-warning")">
                                @(item.IsApproved ? (item.IsActive ? "Aktif" : "Pasif") : "Onay bekliyor")
                            </span>
                        </td>
                        <td>@(item.IsFeatured ? "Öne çıkan" : "Standart")</td>
                        <td>@item.CreatedAt.ToShortDateString()</td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                @if (!item.IsApproved)
                                {
                                    <form asp-action="Approve" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm bb-btn-primary">Onayla</button></form>
                                }
                                <form asp-action="ToggleActive" method="post" onsubmit="return confirm('İşletmenin yayın durumunu değiştirmek istediğinize emin misiniz?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button class="btn btn-sm bb-btn-outline">@(item.IsActive ? "Pasife al" : "Aktif et")</button>
                                </form>
                                <form asp-action="ToggleFeatured" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button class="btn btn-sm bb-btn-outline">@(item.IsFeatured ? "Öne çıkarmayı kaldır" : "Öne çıkar")</button>
                                </form>
                                <a class="btn btn-sm bb-btn-light" asp-action="Details" asp-route-slug="@item.Slug">Detay</a>
                                <a class="btn btn-sm bb-btn-light" asp-action="Edit" asp-route-id="@item.Id">Düzenle</a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state my-0">
            <span class="empty-state-icon">▦</span>
            <h3>@(status == "pending" ? "Onay bekleyen işletme bulunmuyor." : "Henüz işletme bulunamadı.")</h3>
            <p>Filtreyi değiştirerek diğer işletmeleri görüntüleyebilirsin.</p>
        </div>
    }
</div>
