@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Genel bakış";
}

<nav class="bb-breadcrumb" aria-label="Sayfa yolu">
    <span>Yönetim paneli</span>
    <span>Genel bakış</span>
</nav>

<div class="row g-3 mb-4">
    <div class="col-md"><div class="stat-card"><div class="stat-number">@Model.TotalBusinesses</div><div>Toplam işletme</div></div></div>
    <div class="col-md"><div class="stat-card"><div class="stat-number">@Model.PendingBusinesses</div><div>Onay bekleyen işletme</div></div></div>
    <div class="col-md"><div class="stat-card"><div class="stat-number">@Model.TotalUsers</div><div>Toplam kullanıcı</div></div></div>
    <div class="col-md"><div class="stat-card"><div class="stat-number">@Model.TotalReviews</div><div>Toplam yorum</div></div></div>
    <div class="col-md"><div class="stat-card"><div class="stat-number">@Model.TotalCategories</div><div>Toplam kategori</div></div></div>
</div>

<div class="row g-4">
    <div class="col-xl-7">
        <div class="panel-card p-4">
            <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                <h2 class="fw-bold h4 mb-0">Son eklenen işletmeler</h2>
                <a asp-controller="Businesses" asp-action="Index" class="btn btn-sm bb-btn-outline">Tümünü gör</a>
            </div>
            @if (Model.LatestBusinesses.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead><tr><th>İşletme adı</th><th>Kategori</th><th>Onay durumu</th><th>İşlemler</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.LatestBusinesses)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.CategoryName</td>
                                <td><span class="status-pill @(item.IsApproved ? "status-success" : "status-warning")">@(item.IsApproved ? "Onaylandı" : "Onay bekliyor")</span></td>
                                <td><a asp-controller="Businesses" asp-action="Index" class="btn btn-sm bb-btn-outline">Yönet</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state my-0">
                    <span class="empty-state-icon">▦</span>
                    <h3>Henüz işletme bulunamadı.</h3>
                    <p>Yeni işletmeler eklendiğinde burada görünecek.</p>
                </div>
            }
        </div>
    </div>
    <div class="col-xl-5">
        <div class="panel-card p-4">
            <h2 class="fw-bold h4">Son yorumlar</h2>
            @if (Model.LatestReviews.Any())
            {
                @foreach (var review in Model.LatestReviews)
                {
                    <div class="border-top py-3">
                        <strong>@review.BusinessName</strong>
                        <div class="text-muted small">@review.Comment</div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state my-0">
                    <span class="empty-state-icon">✎</span>
                    <h3>Henüz yorum yapılmamış.</h3>
                    <p>Yeni yorumlar onay için buraya düşecek.</p>
                </div>
            }
        </div>
    </div>
</div>
