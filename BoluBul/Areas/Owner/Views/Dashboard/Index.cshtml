@model OwnerDashboardViewModel
@{
    ViewData["Title"] = "Genel bakış";
}

<nav class="bb-breadcrumb" aria-label="Sayfa yolu">
    <span>İşletme paneli</span>
    <span>Genel bakış</span>
</nav>

<div class="row g-3 mb-4">
    <div class="col-md"><div class="stat-card"><div class="stat-number">@Model.TotalBusinesses</div><div>İşletmelerim</div></div></div>
    <div class="col-md"><div class="stat-card"><div class="stat-number">@Model.ApprovedBusinesses</div><div>Onaylandı</div></div></div>
    <div class="col-md"><div class="stat-card"><div class="stat-number">@Model.PendingBusinesses</div><div>Onay bekliyor</div></div></div>
    <div class="col-md"><div class="stat-card"><div class="stat-number">@Model.TotalViews</div><div>Profil görüntülenme</div></div></div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="panel-card p-4"><strong>Telefon tıklaması</strong><div class="stat-number">@Model.PhoneClicks</div></div></div>
    <div class="col-md-4"><div class="panel-card p-4"><strong>WhatsApp tıklaması</strong><div class="stat-number">@Model.WhatsAppClicks</div></div></div>
    <div class="col-md-4"><div class="panel-card p-4"><strong>Yol tarifi tıklaması</strong><div class="stat-number">@Model.DirectionClicks</div></div></div>
</div>

<div class="panel-card p-4">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
        <div>
            <h2 class="fw-bold h4 mb-1">İşletmelerim</h2>
            <p class="text-muted mb-0">İşletme profillerinin onay ve görünürlük durumunu buradan takip edebilirsin.</p>
        </div>
        <a class="btn bb-btn-primary" asp-controller="Businesses" asp-action="Create">Yeni işletme ekle</a>
    </div>
    @if (Model.Businesses.Any())
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>İşletme</th><th>Kategori</th><th>Onay durumu</th><th>Görüntülenme</th><th>İşlemler</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Businesses)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.CategoryName</td>
                        <td><span class="status-pill @(item.IsApproved ? "status-success" : "status-warning")">@(item.IsApproved ? "Onaylandı" : "Onay bekliyor")</span></td>
                        <td>@item.ViewCount</td>
                        <td><a class="btn btn-sm bb-btn-outline" asp-controller="Businesses" asp-action="Edit" asp-route-id="@item.Id">Düzenle</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state my-0">
            <span class="empty-state-icon">＋</span>
            <h3>Henüz işletme eklememişsin.</h3>
            <p>BoluBul’da görünür olmak için ilk işletme profilini oluşturabilirsin.</p>
            <a class="btn bb-btn-primary" asp-controller="Businesses" asp-action="Create">İlk işletmeni ekle</a>
        </div>
    }
</div>
