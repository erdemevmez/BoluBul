@model IReadOnlyList<OwnerBusinessRowViewModel>
@{
    ViewData["Title"] = "İşletmelerim";
}

<nav class="bb-breadcrumb" aria-label="Sayfa yolu">
    <a asp-area="Owner" asp-controller="Dashboard" asp-action="Index">İşletme paneli</a>
    <span>İşletmelerim</span>
</nav>

<div class="panel-card p-4">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
        <div>
            <h2 class="fw-bold h4 mb-1">İşletmelerim</h2>
            <p class="text-muted mb-0">Bilgiler admin onayından sonra yayına alınır.</p>
        </div>
        <a class="btn bb-btn-primary" asp-action="Create">İşletme ekle</a>
    </div>
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>İşletme</th><th>Kategori</th><th>Durum</th><th>İstatistik</th><th>İşlemler</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Name</strong></td>
                        <td>@item.CategoryName</td>
                        <td><span class="status-pill @(item.IsApproved ? (item.IsActive ? "status-success" : "status-muted") : "status-warning")">@(item.IsApproved ? (item.IsActive ? "Yayında" : "Pasif") : "Onay bekliyor")</span></td>
                        <td>@item.ViewCount görüntülenme</td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-sm bb-btn-outline" asp-action="Edit" asp-route-id="@item.Id">Düzenle</a>
                                <a class="btn btn-sm bb-btn-light" asp-action="Images" asp-route-id="@item.Id">Fotoğraflar</a>
                                <a class="btn btn-sm bb-btn-light" asp-action="Hours" asp-route-id="@item.Id">Çalışma saatleri</a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state my-0">
            <span class="empty-state-icon">＋</span>
            <h3>Henüz işletme eklememişsin.</h3>
            <p>BoluBul’da görünür olmak için ilk işletme profilini oluşturabilirsin.</p>
            <a class="btn bb-btn-primary" asp-action="Create">İlk işletmeni ekle</a>
        </div>
    }
</div>
