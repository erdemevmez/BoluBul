@model BusinessCreateViewModel
@{
    ViewData["Title"] = "Yeni işletme ekle";
}

<nav class="bb-breadcrumb" aria-label="Sayfa yolu">
    <a asp-area="Owner" asp-controller="Dashboard" asp-action="Index">İşletme paneli</a>
    <a asp-area="Owner" asp-controller="Businesses" asp-action="Index">İşletmelerim</a>
    <span>Yeni işletme ekle</span>
</nav>

<div class="owner-soft-note mb-4">
    Gönderilen işletme bilgileri admin onayından sonra yayına alınır.
</div>

<div class="panel-card p-4">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <partial name="_BusinessFormFields" model="Model" />
        <div class="d-flex flex-wrap gap-2">
            <button class="btn bb-btn-primary">Kaydet ve onaya gönder</button>
            <a class="btn bb-btn-outline" asp-action="Index">Vazgeç</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
