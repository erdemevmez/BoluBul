@model RegisterViewModel
@{
    ViewData["Title"] = "Kayıt ol";
}

<section class="auth-shell">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="auth-frame">
                    <div class="row g-0">
                        <div class="col-lg-5">
                            <div class="auth-brand-panel h-100">
                                <div class="brand-mark text-white mb-4">
                                    <span class="brand-symbol brand-symbol-light">BB</span>
                                    <span>BoluBul</span>
                                </div>
                                <h2 class="fw-bold">Yerel keşif deneyimine katıl.</h2>
                                <p class="mt-3 mb-0">Bolu’daki işletmeleri keşfetmek, favorilere eklemek ve yorum yapmak için ücretsiz hesap oluştur.</p>
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="auth-card">
                                <div class="section-eyebrow">Yeni hesap</div>
                                <h1 class="section-title">BoluBul hesabı oluştur</h1>
                                <form asp-action="Register" method="post">
                                    @Html.AntiForgeryToken()
                                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                                    <div class="mb-3">
                                        <label asp-for="FullName" class="form-label">Ad soyad</label>
                                        <input asp-for="FullName" class="form-control" autocomplete="name" />
                                        <span asp-validation-for="FullName" class="text-danger"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="Email" class="form-label">E-posta</label>
                                        <input asp-for="Email" class="form-control" autocomplete="email" />
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label asp-for="Password" class="form-label">Şifre</label>
                                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                                            <span asp-validation-for="Password" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="ConfirmPassword" class="form-label">Şifre tekrar</label>
                                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-check my-3">
                                        <input asp-for="RegisterAsBusinessOwner" class="form-check-input" />
                                        <label asp-for="RegisterAsBusinessOwner" class="form-check-label">İşletme sahibi olarak kaydol</label>
                                    </div>
                                    <button class="btn bb-btn-primary w-100" type="submit">Kayıt ol</button>
                                </form>
                                <p class="text-muted mt-3 mb-0">Zaten hesabın var mı? <a asp-action="Login">Giriş yap</a></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
