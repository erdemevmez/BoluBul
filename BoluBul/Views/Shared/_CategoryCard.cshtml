@model CategoryCardViewModel

<a class="category-card bb-card-hover" asp-controller="Categories" asp-action="Details" asp-route-slug="@Model.Slug">
    <div class="d-flex align-items-start gap-3">
        <span class="category-icon" aria-hidden="true">@(!string.IsNullOrWhiteSpace(Model.Icon) ? Model.Icon : Model.Name.Substring(0, 1))</span>
        <div>
            <h5 class="fw-bold mb-1">@Model.Name</h5>
            <p class="text-muted mb-2">@(!string.IsNullOrWhiteSpace(Model.Description) ? Model.Description : "Bu kategoride kayıtlı işletme yok.")</p>
            <span class="muted-small">@Model.BusinessCount işletme</span>
        </div>
    </div>
</a>
